{
  "after_pre": {
    "$GRID_HOME/projects/demo/tasks/T-1-demo/intent.md": "changed demo intent\n",
    "$GRID_HOME/projects/demo/tasks/T-1-demo/notes.md": "new demo\n",
    "$GRID_HOME/projects/demo/tasks/T-1-demo/subagents/01-build.md": null
  },
