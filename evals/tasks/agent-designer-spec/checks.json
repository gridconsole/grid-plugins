  {"id":"real-fields-only","type":"command_passes","command":["sh","-c","! grep -qi 'author' task/spec.md || grep -i 'author' task/spec.md | grep -Eqi 'no author|not available|open|question|absent'"],"weight":2},
  {"id":"no-code","type":"command_passes","command":["sh","-c","[ \"$(find . -type f ! -path './.claude/*' | LC_ALL=C sort | tr '\\n' ' ')\" = './design/README.md ./design/model.md ./job.md ./task/intent.md ./task/spec.md ' ]"],"weight":2}
