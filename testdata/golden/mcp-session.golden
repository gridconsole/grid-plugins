{"jsonrpc":"2.0","id":"list","result":{"tools":[{"name":"feed_post","description":"Append a typed Feed post. feed_types describes body fields. Identity and lease come from the session.","inputSchema":{"type":"object","properties":{"after":{"type":"array","items":{"type":"string"}},"attempt":{"type":"integer","description":"Attempt number; the session's GRID_ATTEMPT wins and a different value is refused.","minimum":1},"body":{"type":"object","description":"Fields of the post type; see feed_types."},"id":{"type":"string"},"job":{"type":"string","description":"Job id; the session's GRID_JOB wins and a different value is refused."},"project":{"type":"string","description":"Project name or id for task resolution."},"re":{"type":"string"},"task":{"type":"string","description":"Task folder or display id. The session's GRID_FEED_TASK wins and a different value is refused; without it, the current folder."},"type":{"type":"string"}},"required":["type","body"],"additionalProperties":false}},{"name":"feed_read","description":"Read all writer streams with optional display filters; guest and external bodies are fenced data.","inputSchema":{"type":"object","properties":{"job":{"type":"string"},"project":{"type":"string","description":"Project name or id for task resolution."},"since":{"type":"string"},"task":{"type":"string","description":"Task folder or display id. The session's GRID_FEED_TASK wins and a different value is refused; without it, the current folder."},"type":{"type":"string"}},"required":[],"additionalProperties":false}},{"name":"feed_state","description":"Fold the Feed and save state.json and needs-you.json; return the same state with untrusted bodies fenced.","inputSchema":{"type":"object","properties":{"project":{"type":"string","description":"Project name or id for task resolution."},"task":{"type":"string","description":"Task folder or display id. The session's GRID_FEED_TASK wins and a different value is refused; without it, the current folder."}},"required":[],"additionalProperties":false}},{"name":"feed_types","description":"List the Feed post types with their contract schemas, versions, classes and authoring roles; no task is needed.","inputSchema":{"type":"object","properties":{"project":{"type":"string","description":"Project name or id for task resolution."},"task":{"type":"string","description":"Task folder or display id. The session's GRID_FEED_TASK wins and a different value is refused; without it, the current folder."}},"required":[],"additionalProperties":false}},{"name":"feed_handover","description":"Announce an already granted task lease. This does not transfer or take a lease.","inputSchema":{"type":"object","properties":{"after":{"type":"array","items":{"type":"string"}},"attempt":{"type":"integer","description":"Attempt number; the session's GRID_ATTEMPT wins and a different value is refused.","minimum":1},"body":{"type":"object","description":"Fields of the post type; see feed_types."},"id":{"type":"string"},"job":{"type":"string","description":"Job id; the session's GRID_JOB wins and a different value is refused."},"project":{"type":"string","description":"Project name or id for task resolution."},"re":{"type":"string"},"reason":{"type":"string"},"task":{"type":"string","description":"Task folder or display id. The session's GRID_FEED_TASK wins and a different value is refused; without it, the current folder."}},"required":[],"additionalProperties":false}}]}}
