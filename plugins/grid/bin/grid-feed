#!/usr/bin/env node
// grid-feed post|read|state|types: the Feed tools from a shell, a hook or a Codex session (the MCP server does the same).
//   grid-feed post  --task T-12 --type result --body '{"outcome":"..."}' [--re <post id>] [--job J-1]   (--body - reads stdin)
//   grid-feed read  --task T-12 [--since <post id or at>] [--type result] [--job J-1]
//   grid-feed state --task T-12
//   grid-feed types [--task T-12]
// The task may also come first as a bare argument. The result is JSON on stdout; an error is a line on stderr and exit 1, a usage error exit 2.
// Written with dynamic import only, so it runs the same whether Node reads an extensionless file as CommonJS or as a module.
(async () => {
  const TOOL = { post: 'feed_post', read: 'feed_read', state: 'feed_state', types: 'feed_types' };
  const FLAGS = { post: ['task', 'type', 'body', 're', 'job'], read: ['task', 'since', 'type', 'job'], state: ['task'], types: ['task'] };
  const usage = (msg) => {
    process.stderr.write(`${msg ? `${msg}\n` : ''}usage: grid-feed post --task T-12 --type <type> --body '<json>' [--re <id>] [--job <id>]\n       grid-feed read --task T-12 [--since <id|at>] [--type <type>] [--job <id>]\n       grid-feed state --task T-12\n       grid-feed types [--task T-12]\n`);
    process.exit(msg ? 2 : 0);
  };
  const [cmd, ...rest] = process.argv.slice(2);
  if (!cmd || cmd === '-h' || cmd === '--help') usage(cmd ? '' : 'a command is required');
  if (!TOOL[cmd]) usage(`unknown command ${cmd}`);
  const args = {};
  for (let i = 0; i < rest.length; i++) {
    const m = /^--([a-z]+)(?:=([\s\S]*))?$/.exec(rest[i]);
    if (!m) {
      if (args.task === undefined && !rest[i].startsWith('-')) { args.task = rest[i]; continue; }
      usage(`unexpected argument ${rest[i]}`);
    }
    if (!FLAGS[cmd].includes(m[1])) usage(`${m[1] === 'help' ? 'no such flag' : `--${m[1]} is not a flag of ${cmd}`}`);
    const v = m[2] ?? rest[++i];
    if (v === undefined) usage(`--${m[1]} needs a value`);
    args[m[1]] = v;
  }
  if (cmd === 'post' && args.body !== undefined) {
    let text = args.body;
    if (text === '-') text = await new Promise((resolve, reject) => {
      let s = '';
      process.stdin.setEncoding('utf8');
      process.stdin.on('data', (d) => { s += d; });
      process.stdin.on('end', () => resolve(s));
      process.stdin.on('error', reject);
    });
    try { args.body = JSON.parse(text); } catch { process.stderr.write('grid-feed: --body is not JSON\n'); process.exit(1); }
  }
  const { callTool } = await import('../feed/lib.mjs');
  const result = callTool(TOOL[cmd], args, { env: process.env, cwd: process.cwd() });
  if (!result.ok) { process.stderr.write(`grid-feed: ${result.errors.join('; ')}\n`); process.exit(1); }
  process.stdout.write(`${JSON.stringify(result, null, 2)}\n`);
})();
