{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/session-check.mjs\"", "timeout": 10 },
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/grid-env.mjs\"", "timeout": 10 },
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/agent-routing.mjs\"", "timeout": 10 },
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/usage-log.mjs\"", "timeout": 10 },
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/session-attach.mjs\"", "timeout": 10 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/session-attach.mjs\"", "timeout": 10 },
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/brain-recall.mjs\"", "timeout": 10 }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "grid-planner|grid:grid-planner",
        "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/brain-recall.mjs\"", "timeout": 10 }]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash",
        "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/plan-guard.mjs\"", "timeout": 10 }]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash",
        "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/host-guard.mjs\"", "timeout": 10 }]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/brief-lint.mjs\"", "timeout": 10 },
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/brain-recall.mjs\"", "timeout": 10 }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/history-log.mjs\"", "timeout": 10 }]
      },
      {
        "matcher": "Skill|Agent|Task",
        "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/session-attach.mjs\"", "timeout": 10 }]
      },
      {
        "matcher": "Read|Write|Edit|MultiEdit|Glob|Grep|NotebookEdit|Bash",
        "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/grid-home-allow.mjs\"", "timeout": 10 }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash",
        "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/history-log.mjs\"", "timeout": 10 }]
      },
      {
        "matcher": "Read",
        "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/brain-read.mjs\"", "timeout": 10 }]
      },
      {
        "matcher": "Skill",
        "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/brain-recall.mjs\"", "timeout": 10 }]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/usage-log.mjs\"", "timeout": 10 }]
      },
      {
        "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/heartbeat.mjs\"", "timeout": 5 }]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/history-log.mjs\"", "timeout": 10 }]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/history-log.mjs\"", "timeout": 10 },
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/stop-check.mjs\"", "timeout": 10 },
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/usage-log.mjs\"", "timeout": 10 },
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/session-record.mjs\"", "timeout": 10 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/stop-check.mjs\"", "timeout": 10 },
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/session-record.mjs\"", "timeout": 10 }
        ]
      },
      {
        "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/heartbeat.mjs\"", "timeout": 5 }]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/session-record.mjs\"", "timeout": 10 }
        ]
      },
      {
        "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/worker-exit.mjs\"", "timeout": 5 }]
      }
    ],
    "Notification": [
      {
        "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/needs-you.mjs\"", "timeout": 10 }]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/permission-forward.mjs\"", "timeout": 100 }]
      },
      {
        "matcher": "Read|Write|Edit|MultiEdit|Glob|Grep|NotebookEdit|Bash",
        "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/grid-home-allow.mjs\"", "timeout": 10 }]
      }
    ]
  }
}
