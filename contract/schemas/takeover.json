{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/grid/contract/takeover.json",
  "title": "takeover",
  "type": "object",
  "properties": {
    "writer": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^/\\s]+@[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "file": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^/]+\\.[1-9][0-9]*\\.jsonl$"
    },
    "fence": {
      "type": "integer",
      "minimum": 1
    },
    "end_offset": {
      "type": "integer",
      "minimum": 0
    },
    "at": {
      "type": "string",
      "minLength": 1,
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    }
  },
  "required": [
    "writer",
    "file",
    "fence",
    "end_offset",
    "at"
  ],
  "additionalProperties": false
}
