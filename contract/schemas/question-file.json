{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/grid/contract/question-file.json",
  "title": "Task question file",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^Q-[1-9][0-9]*$"
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "who": {
      "type": "string",
      "minLength": 1
    },
    "why": {
      "type": "string",
      "minLength": 1
    },
    "blocking": {
      "type": "boolean"
    },
    "options": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "recommended": {
      "type": "string",
      "minLength": 1
    },
    "gate": {
      "type": "object",
      "properties": {
        "default": {
          "type": "string",
          "minLength": 1
        },
        "at": {
          "type": "string",
          "minLength": 1,
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
        },
        "kind": {
          "const": "person"
        },
        "id": {
          "type": "string",
          "pattern": "^Q-[1-9][0-9]*$"
        }
      },
      "required": [
        "default",
        "at",
        "kind",
        "id"
      ],
      "additionalProperties": false
    },
    "asked": {
      "type": "string",
      "minLength": 1,
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "state": {
      "enum": [
        "open",
        "answered",
        "defaulted",
        "withdrawn"
      ]
    },
    "answer": {
      "type": "string"
    },
    "age_after_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4611686018
    },
    "aging": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "enum": [
              "answered",
              "defaulted",
              "withdrawn",
              "aged"
            ]
          },
          "at": {
            "type": "string",
            "minLength": 1,
            "format": "date-time",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
          },
          "who": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string"
          },
          "post": {
            "type": "string",
            "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
          },
          "role": {
            "enum": [
              "owner",
              "member",
              "guest",
              "lead",
              "agent",
              "cli"
            ]
          }
        },
        "required": [
          "kind",
          "at",
          "who",
          "text",
          "post",
          "role"
        ],
        "additionalProperties": false
      }
    },
    "post": {
      "type": "string",
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "job": {
      "type": "string",
      "pattern": "^J-[1-9][0-9]*(\\.[1-9][0-9]*)*$"
    },
    "item": {
      "type": "integer",
      "minimum": 1
    }
  },
  "required": [
    "id",
    "question",
    "who",
    "blocking",
    "gate",
    "asked",
    "state",
    "answer",
    "age_after_seconds",
    "aging",
    "history",
    "post"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "required": [
          "options"
        ],
        "properties": {
          "options": {
            "minItems": 1
          }
        }
      },
      "then": {
        "required": [
          "recommended"
        ]
      }
    }
  ]
}
