{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/grid/contract/merge-lease.json",
  "title": "merge-lease",
  "type": "object",
  "properties": {
    "lease": {
      "const": "merge"
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "holder": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^@/\\s]+@[0-7][0-9A-HJKMNP-TV-Z]{25}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "fence": {
      "type": "integer",
      "minimum": 1
    },
    "gen": {
      "type": "integer",
      "minimum": 0
    },
    "since": {
      "type": "string",
      "minLength": 1,
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "until": {
      "type": "string",
      "minLength": 1,
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "renewed_at": {
      "type": "string",
      "minLength": 1,
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    }
  },
  "required": [
    "lease",
    "project",
    "holder",
    "fence",
    "gen",
    "since",
    "until"
  ],
  "additionalProperties": false,
  "description": "One lease per project. Expires 15 minutes after renewed_at, or since when never renewed. A stale lease may be broken by the next lander. Validate checks this duration."
}
