{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/grid/contract/checkpoint.json",
  "title": "checkpoint",
  "allOf": [
    {
      "$ref": "envelope.json"
    },
    {
      "properties": {
        "type": {
          "const": "checkpoint"
        },
        "type_v": {
          "const": 1
        },
        "author": {
          "properties": {
            "role": {
              "enum": [
                "worker",
                "agent",
                "cli"
              ]
            }
          }
        },
        "body": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "job": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^J-[1-9][0-9]*(\\.[1-9][0-9]*)*$"
                },
                "step": {
                  "type": "string",
                  "minLength": 1
                },
                "commit": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[0-9a-f]{7,64}$"
                }
              },
              "required": [
                "job",
                "step",
                "commit"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "job": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^J-[1-9][0-9]*(\\.[1-9][0-9]*)*$"
                },
                "acceptance": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^A[1-9][0-9]*$"
                    },
                    "state": {
                      "enum": [
                        "pending",
                        "met",
                        "not met",
                        "not-met",
                        "waiting"
                      ]
                    },
                    "note": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "id",
                    "state"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "job",
                "acceptance"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "ref": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^bodies/[0-7][0-9A-HJKMNP-TV-Z]{25}\\.json$"
                }
              },
              "required": [
                "ref"
              ],
              "additionalProperties": false
            }
          ]
        },
        "lease": {
          "type": "string",
          "minLength": 1,
          "pattern": "^J-[1-9][0-9]*(\\.[1-9][0-9]*)*$"
        },
        "fence": {
          "type": "integer",
          "minimum": 1
        },
        "job": {
          "type": "string",
          "minLength": 1,
          "pattern": "^J-[1-9][0-9]*(\\.[1-9][0-9]*)*$"
        },
        "attempt": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  ],
  "x-class": "state",
  "x-roles": [
    "worker",
    "agent",
    "cli"
  ]
}
