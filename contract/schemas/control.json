{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/grid/contract/control.json",
  "title": "control",
  "allOf": [
    {
      "$ref": "envelope.json"
    },
    {
      "properties": {
        "type": {
          "const": "control"
        },
        "type_v": {
          "const": 1
        },
        "body": {
          "oneOf": [
            {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "assign": {
                      "type": "object",
                      "properties": {
                        "job": {
                          "type": "string",
                          "minLength": 1,
                          "pattern": "^J-[1-9][0-9]*(\\.[1-9][0-9]*)*$"
                        },
                        "attempt": {
                          "type": "integer",
                          "minimum": 1
                        },
                        "to": {
                          "type": "string",
                          "minLength": 1,
                          "pattern": "^[^/\\s]+@[0-7][0-9A-HJKMNP-TV-Z]{25}$"
                        },
                        "fence": {
                          "type": "integer",
                          "minimum": 1
                        },
                        "until": {
                          "type": "string",
                          "minLength": 1,
                          "format": "date-time",
                          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
                        }
                      },
                      "required": [
                        "job",
                        "attempt",
                        "to",
                        "fence",
                        "until"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "assign"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "target": {
                      "anyOf": [
                        {
                          "type": "string",
                          "pattern": "^J-[1-9][0-9]*(\\.[1-9][0-9]*)*$"
                        },
                        {
                          "type": "string",
                          "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
                        }
                      ]
                    },
                    "status": {
                      "enum": [
                        "posted",
                        "ready",
                        "running",
                        "submitted",
                        "integrated",
                        "accepted",
                        "stale",
                        "parked",
                        "rejected",
                        "conflict",
                        "cancelled"
                      ]
                    },
                    "reason": {
                      "type": "string",
                      "minLength": 1
                    },
                    "close_reason": {
                      "type": "string",
                      "minLength": 1
                    },
                    "attempt": {
                      "type": "integer",
                      "minimum": 1
                    }
                  },
                  "required": [
                    "target",
                    "status",
                    "reason"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "target": {
                      "anyOf": [
                        {
                          "type": "string",
                          "pattern": "^J-[1-9][0-9]*(\\.[1-9][0-9]*)*$"
                        },
                        {
                          "type": "string",
                          "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
                        }
                      ]
                    },
                    "reason": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "target",
                    "reason"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "target": {
                      "type": "string",
                      "pattern": "^J-[1-9][0-9]*(\\.[1-9][0-9]*)*$"
                    },
                    "order": {
                      "type": "integer",
                      "minimum": 0
                    }
                  },
                  "required": [
                    "target",
                    "order"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "target": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
                    },
                    "answer": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
                    },
                    "status": {
                      "enum": [
                        "answered",
                        "closed"
                      ]
                    }
                  },
                  "required": [
                    "target",
                    "answer",
                    "status"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "target": {
                      "type": "string",
                      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
                    },
                    "question_event": {
                      "enum": [
                        "withdrawn",
                        "aged",
                        "defaulted"
                      ]
                    },
                    "text": {
                      "type": "string"
                    },
                    "level": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 2
                    }
                  },
                  "required": [
                    "target",
                    "question_event",
                    "text"
                  ],
                  "additionalProperties": false
                }
              ],
              "allOf": [
                {
                  "if": {
                    "required": [
                      "status"
                    ],
                    "properties": {
                      "status": {
                        "enum": [
                          "cancelled",
                          "rejected"
                        ]
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "close_reason"
                    ]
                  }
                }
              ]
            },
            {
              "type": "object",
              "properties": {
                "ref": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^bodies/[0-7][0-9A-HJKMNP-TV-Z]{25}\\.json$"
                }
              },
              "required": [
                "ref"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "oneOf": [
        {
          "properties": {
            "author": {
              "properties": {
                "role": {
                  "enum": [
                    "lead",
                    "owner",
                    "member",
                    "cli"
                  ]
                }
              }
            },
            "lease": {
              "const": "task"
            },
            "fence": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        {
          "properties": {
            "author": {
              "properties": {
                "role": {
                  "enum": [
                    "owner",
                    "member",
                    "lead",
                    "guest"
                  ]
                }
              }
            },
            "lease": {
              "type": "null"
            },
            "gen": {
              "const": 0
            },
            "fence": {
              "const": 0
            },
            "re": {
              "type": "string",
              "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
            },
            "body": {
              "type": "object",
              "properties": {
                "target": {
                  "type": "string",
                  "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
                },
                "question_event": {
                  "const": "withdrawn"
                },
                "text": {
                  "type": "string"
                }
              },
              "required": [
                "target",
                "question_event",
                "text"
              ],
              "additionalProperties": false
            }
          }
        }
      ]
    }
  ],
  "x-class": "state",
  "x-roles": [
    "lead",
    "owner",
    "member",
    "cli",
    "guest"
  ]
}
