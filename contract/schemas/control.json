{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/grid/contract/control.json",
  "title": "control",
  "allOf": [
    {
      "$ref": "envelope.json"
    },
    {
      "properties": {
        "type": {
          "const": "control"
        },
        "type_v": {
          "const": 1
        },
        "body": {
          "oneOf": [
            {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "assign": {
                      "type": "object",
                      "properties": {
                        "job": {
                          "type": "string",
                          "minLength": 1,
                          "pattern": "^J-[1-9][0-9]*(\\.[1-9][0-9]*)*$"
                        },
                        "attempt": {
                          "type": "integer",
                          "minimum": 1
                        },
                        "to": {
                          "type": "string",
                          "minLength": 1,
                          "pattern": "^[^/\\s]+@[0-7][0-9A-HJKMNP-TV-Z]{25}$"
                        },
                        "fence": {
                          "type": "integer",
                          "minimum": 1
                        },
                        "until": {
                          "type": "string",
                          "minLength": 1,
                          "format": "date-time",
                          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
                        },
                        "on": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 200
                        },
                        "account": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 200
                        },
                        "model": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 100
                        },
                        "effort": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 40
                        },
                        "start": {
                          "anyOf": [
                            {
                              "const": "now"
                            },
                            {
                              "type": "object",
                              "properties": {
                                "all": {
                                  "type": "array",
                                  "minItems": 1,
                                  "items": {
                                    "type": "object"
                                  }
                                },
                                "any": {
                                  "type": "array",
                                  "minItems": 1,
                                  "items": {
                                    "type": "object"
                                  }
                                },
                                "wait_max": {
                                  "type": "string",
                                  "pattern": "^[1-9][0-9]*(s|m|h|d)$"
                                },
                                "missed": {
                                  "enum": [
                                    "run-once",
                                    "skip"
                                  ]
                                },
                                "tz": {
                                  "type": "string",
                                  "minLength": 1
                                }
                              }
                            }
                          ]
                        },
                        "expect": {
                          "type": "object",
                          "properties": {
                            "cores": {
                              "type": "number",
                              "minimum": 0
                            },
                            "mem_gb": {
                              "type": "number",
                              "minimum": 0
                            }
                          },
                          "additionalProperties": false
                        },
                        "test_run": {
                          "type": "boolean"
                        },
                        "base": {
                          "type": "object",
                          "properties": {
                            "ref": {
                              "type": "string",
                              "minLength": 1,
                              "pattern": "^refs/"
                            },
                            "sha": {
                              "type": "string",
                              "pattern": "^[0-9a-f]{7,64}$"
                            }
                          },
                          "required": [
                            "ref"
                          ],
                          "additionalProperties": false
                        },
                        "allow": {
                          "type": "array",
                          "uniqueItems": true,
                          "items": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 500
                          }
                        },
                        "grant": {
                          "type": "string",
                          "minLength": 1,
                          "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
                        },
                        "carry": {
                          "type": "object",
                          "properties": {
                            "job": {
                              "type": "string",
                              "minLength": 1,
                              "pattern": "^J-[1-9][0-9]*(\\.[1-9][0-9]*)*$"
                            },
                            "attempt": {
                              "type": "integer",
                              "minimum": 1
                            }
                          },
                          "required": [
                            "job",
                            "attempt"
                          ],
                          "additionalProperties": false
                        }
                      },
                      "required": [
                        "job",
                        "attempt",
                        "to",
                        "fence",
                        "until"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "assign"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "target": {
                      "anyOf": [
                        {
                          "type": "string",
                          "pattern": "^J-[1-9][0-9]*(\\.[1-9][0-9]*)*$"
                        },
                        {
                          "type": "string",
                          "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
                        }
                      ]
                    },
                    "status": {
                      "enum": [
                        "posted",
                        "ready",
                        "running",
                        "submitted",
                        "integrated",
                        "accepted",
                        "stale",
                        "parked",
                        "rejected",
                        "conflict",
                        "cancelled"
                      ]
                    },
                    "reason": {
                      "type": "string",
                      "minLength": 1
                    },
                    "close_reason": {
                      "type": "string",
                      "minLength": 1
                    },
                    "attempt": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "answer": {
                      "type": "string",
                      "minLength": 1
                    },
                    "plan_hash": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{6}$"
                    },
                    "plan_digest": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "lands_hash": {
                      "type": "string",
                      "minLength": 1
                    },
                    "note": {
                      "type": "string",
                      "minLength": 1
                    },
                    "send_back": {
                      "const": true
                    },
                    "sent_back_hash": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{6}$"
                    }
                  },
                  "required": [
                    "target",
                    "status",
                    "reason"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "target": {
                      "anyOf": [
                        {
                          "type": "string",
                          "pattern": "^J-[1-9][0-9]*(\\.[1-9][0-9]*)*$"
                        },
                        {
                          "type": "string",
                          "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
                        }
                      ]
                    },
                    "reason": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "target",
                    "reason"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "target": {
                      "type": "string",
                      "pattern": "^J-[1-9][0-9]*(\\.[1-9][0-9]*)*$"
                    },
                    "order": {
                      "type": "integer",
                      "minimum": 0
                    }
                  },
                  "required": [
                    "target",
                    "order"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "target": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
                    },
                    "answer": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
                    },
                    "status": {
                      "enum": [
                        "answered",
                        "closed"
                      ]
                    }
                  },
                  "required": [
                    "target",
                    "answer",
                    "status"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "target": {
                      "type": "string",
                      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
                    },
                    "question_event": {
                      "enum": [
                        "withdrawn",
                        "aged",
                        "defaulted",
                        "waiting"
                      ]
                    },
                    "text": {
                      "type": "string"
                    },
                    "level": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 2
                    }
                  },
                  "required": [
                    "target",
                    "question_event",
                    "text"
                  ],
                  "additionalProperties": false
                }
              ],
              "allOf": [
                {
                  "if": {
                    "required": [
                      "status"
                    ],
                    "properties": {
                      "status": {
                        "enum": [
                          "cancelled",
                          "rejected"
                        ]
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "close_reason"
                    ]
                  }
                }
              ]
            },
            {
              "type": "object",
              "properties": {
                "ref": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^bodies/[0-7][0-9A-HJKMNP-TV-Z]{25}\\.json$"
                }
              },
              "required": [
                "ref"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "oneOf": [
        {
          "properties": {
            "author": {
              "properties": {
                "role": {
                  "enum": [
                    "lead",
                    "owner",
                    "member",
                    "cli"
                  ]
                }
              }
            },
            "lease": {
              "const": "task"
            },
            "fence": {
              "type": "integer",
              "minimum": 1
            },
            "body": {
              "not": {
                "required": [
                  "question_event"
                ],
                "properties": {
                  "question_event": {
                    "const": "waiting"
                  }
                }
              }
            }
          }
        },
        {
          "properties": {
            "author": {
              "properties": {
                "role": {
                  "enum": [
                    "owner",
                    "member",
                    "lead",
                    "guest"
                  ]
                }
              }
            },
            "lease": {
              "type": "null"
            },
            "gen": {
              "const": 0
            },
            "fence": {
              "const": 0
            },
            "re": {
              "type": "string",
              "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
            },
            "body": {
              "type": "object",
              "properties": {
                "target": {
                  "type": "string",
                  "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
                },
                "question_event": {
                  "enum": [
                    "withdrawn",
                    "waiting"
                  ]
                },
                "text": {
                  "type": "string"
                }
              },
              "required": [
                "target",
                "question_event",
                "text"
              ],
              "additionalProperties": false
            }
          }
        },
        {
          "properties": {
            "author": {
              "properties": {
                "role": {
                  "enum": [
                    "owner",
                    "member",
                    "lead"
                  ]
                }
              }
            },
            "lease": {
              "type": "null"
            },
            "gen": {
              "const": 0
            },
            "fence": {
              "const": 0
            },
            "body": {
              "type": "object",
              "properties": {
                "target": {
                  "type": "string",
                  "pattern": "^J-[1-9][0-9]*(\\.[1-9][0-9]*)*$"
                },
                "status": {
                  "const": "cancelled"
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                },
                "close_reason": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "target",
                "status",
                "reason",
                "close_reason"
              ],
              "additionalProperties": false
            }
          }
        }
      ]
    }
  ],
  "x-class": "state",
  "x-roles": [
    "lead",
    "owner",
    "member",
    "cli",
    "guest"
  ]
}
