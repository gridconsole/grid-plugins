{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/grid/contract/transfer.json",
  "title": "transfer",
  "allOf": [
    {
      "$ref": "envelope.json"
    },
    {
      "properties": {
        "type": {
          "const": "transfer"
        },
        "type_v": {
          "const": 1
        },
        "author": {
          "properties": {
            "role": {
              "enum": [
                "lead",
                "owner",
                "member",
                "cli"
              ]
            }
          }
        },
        "body": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "to": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[^/\\s]+@[0-7][0-9A-HJKMNP-TV-Z]{25}$"
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "to"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "ref": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^bodies/[0-7][0-9A-HJKMNP-TV-Z]{25}\\.json$"
                }
              },
              "required": [
                "ref"
              ],
              "additionalProperties": false
            }
          ]
        }
      }
    }
  ],
  "x-class": "state",
  "x-roles": [
    "lead",
    "owner",
    "member",
    "cli"
  ]
}
