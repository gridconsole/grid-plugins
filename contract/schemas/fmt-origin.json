{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "origin",
  "description": "The required origin block from brain note front matter. Null and absent stamps are invalid. Legacy notes must pass through the external-import upgrade path documented in formats.md before validation.",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "session",
        "job",
        "server",
        "import"
      ]
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\r\n\u0000]+$",
      "not": {
        "pattern": "^[\t\n\u000b\f\r    -     　]*$"
      }
    },
    "tier": {
      "type": "string",
      "enum": [
        "person-team",
        "person-guest",
        "agent",
        "external"
      ]
    }
  },
  "required": [
    "kind",
    "id",
    "tier"
  ],
  "additionalProperties": false
}
