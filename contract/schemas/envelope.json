{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/grid/contract/envelope.json",
  "title": "envelope",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "task": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "type": {
      "type": "string",
      "minLength": 1
    },
    "type_v": {
      "type": "integer",
      "minimum": 1
    },
    "author": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": [
            "owner",
            "member",
            "lead",
            "agent",
            "worker",
            "reviewer",
            "curator",
            "host",
            "cli",
            "guest",
            "external"
          ]
        }
      },
      "required": [
        "id",
        "role"
      ],
      "additionalProperties": false
    },
    "tier": {
      "$ref": "trust-tier.json"
    },
    "worker": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^/\\s]+@[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "lease": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": "^(task|J-[1-9][0-9]*(\\.[1-9][0-9]*)*)$"
        },
        {
          "type": "null"
        }
      ]
    },
    "gen": {
      "type": "integer",
      "minimum": 0
    },
    "fence": {
      "type": "integer",
      "minimum": 0
    },
    "seq": {
      "type": "integer",
      "minimum": 1
    },
    "at": {
      "type": "string",
      "minLength": 1,
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "re": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "after": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
      },
      "uniqueItems": true
    },
    "job": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": "^J-[1-9][0-9]*(\\.[1-9][0-9]*)*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "attempt": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "wake": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}/[1-9][0-9]*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "body": {
      "type": "object"
    },
    "by": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^:\\s]+:[^:\\s]+$"
    },
    "legacy": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    }
  },
  "required": [
    "id",
    "task",
    "type",
    "type_v",
    "author",
    "tier",
    "worker",
    "lease",
    "gen",
    "fence",
    "seq",
    "at",
    "re",
    "after",
    "job",
    "attempt",
    "wake",
    "body"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "oneOf": [
        {
          "properties": {
            "fence": {
              "const": 0
            },
            "lease": {
              "type": "null"
            }
          }
        },
        {
          "properties": {
            "fence": {
              "type": "integer",
              "minimum": 1
            },
            "lease": {
              "type": "string"
            }
          }
        }
      ]
    },
    {
      "if": {
        "properties": {
          "author": {
            "properties": {
              "role": {
                "enum": [
                  "owner",
                  "member",
                  "lead"
                ]
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "tier": {
            "const": "person-team"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "author": {
            "properties": {
              "role": {
                "enum": [
                  "guest"
                ]
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "tier": {
            "const": "person-guest"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "author": {
            "properties": {
              "role": {
                "enum": [
                  "external"
                ]
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "tier": {
            "const": "external"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "author": {
            "properties": {
              "role": {
                "enum": [
                  "agent",
                  "worker",
                  "reviewer",
                  "curator",
                  "host",
                  "cli"
                ]
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "tier": {
            "const": "agent"
          }
        }
      }
    }
  ]
}
