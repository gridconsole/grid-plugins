{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/grid/contract/head.json",
  "title": "head",
  "allOf": [
    {
      "$ref": "envelope.json"
    },
    {
      "properties": {
        "type": {
          "const": "head"
        },
        "type_v": {
          "const": 1
        },
        "author": {
          "properties": {
            "role": {
              "enum": [
                "lead",
                "owner",
                "member",
                "cli"
              ]
            }
          }
        },
        "body": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "sha": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[0-9a-f]{7,64}$"
                },
                "ref": {
                  "type": "string",
                  "minLength": 1
                },
                "from_jobs": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^J-[1-9][0-9]*(\\.[1-9][0-9]*)*$"
                  }
                }
              },
              "required": [
                "sha"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "ref": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^bodies/[0-7][0-9A-HJKMNP-TV-Z]{25}\\.json$"
                }
              },
              "required": [
                "ref"
              ],
              "additionalProperties": false
            }
          ]
        }
      }
    }
  ],
  "x-class": "state",
  "x-roles": [
    "lead",
    "owner",
    "member",
    "cli"
  ]
}
