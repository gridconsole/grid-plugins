{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/grid/contract/usage-notice.json",
  "title": "usage-notice",
  "allOf": [
    {
      "$ref": "envelope.json"
    },
    {
      "properties": {
        "type": {
          "const": "usage-notice"
        },
        "type_v": {
          "const": 1
        },
        "author": {
          "properties": {
            "role": {
              "enum": [
                "cli"
              ]
            }
          }
        },
        "body": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "task": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
                },
                "threshold": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                "dollars": {
                  "type": "number",
                  "minimum": 0
                },
                "minutes": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "required": [
                "task",
                "threshold"
              ],
              "additionalProperties": false,
              "oneOf": [
                {
                  "required": [
                    "dollars"
                  ],
                  "not": {
                    "required": [
                      "minutes"
                    ]
                  }
                },
                {
                  "required": [
                    "minutes"
                  ],
                  "not": {
                    "required": [
                      "dollars"
                    ]
                  }
                }
              ]
            },
            {
              "type": "object",
              "properties": {
                "ref": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^bodies/[0-7][0-9A-HJKMNP-TV-Z]{25}\\.json$"
                }
              },
              "required": [
                "ref"
              ],
              "additionalProperties": false
            }
          ]
        }
      }
    }
  ],
  "x-class": "chatter",
  "x-roles": [
    "cli"
  ]
}
