{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/grid/contract/deploy-failed.json",
  "title": "deploy-failed",
  "allOf": [
    {
      "$ref": "envelope.json"
    },
    {
      "properties": {
        "type": {
          "const": "deploy-failed"
        },
        "type_v": {
          "const": 1
        },
        "author": {
          "properties": {
            "role": {
              "enum": [
                "lead",
                "owner",
                "member",
                "cli"
              ]
            }
          }
        },
        "body": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "env": {
                  "type": "string",
                  "minLength": 1
                },
                "stage": {
                  "enum": [
                    "dev",
                    "test",
                    "prod"
                  ]
                },
                "reason": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 400
                },
                "on_fail": {
                  "enum": [
                    "revert",
                    "fix-forward"
                  ]
                },
                "attempt": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "env",
                "stage",
                "reason"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "ref": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^bodies/[0-7][0-9A-HJKMNP-TV-Z]{25}\\.json$"
                }
              },
              "required": [
                "ref"
              ],
              "additionalProperties": false
            }
          ]
        }
      }
    }
  ],
  "x-class": "state",
  "x-roles": [
    "lead",
    "owner",
    "member",
    "cli"
  ]
}
