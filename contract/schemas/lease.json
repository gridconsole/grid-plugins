{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/grid/contract/lease.json",
  "title": "lease",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "lease": {
          "enum": [
            "task"
          ]
        },
        "holder": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "^[^/\\s]+@[0-7][0-9A-HJKMNP-TV-Z]{25}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "fence": {
          "type": "integer",
          "minimum": 1
        },
        "gen": {
          "type": "integer",
          "minimum": 0
        },
        "attempt": {
          "type": "null"
        },
        "since": {
          "type": "string",
          "minLength": 1,
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
        },
        "pid": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "pid_start": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "format": "date-time",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "lease",
        "holder",
        "fence",
        "gen",
        "attempt",
        "since",
        "pid",
        "pid_start"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "holder": {
                "type": "string"
              }
            }
          },
          "then": {
            "properties": {
              "pid": {
                "type": "integer",
                "minimum": 1
              },
              "pid_start": {
                "type": "string",
                "minLength": 1,
                "format": "date-time",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
              }
            }
          }
        }
      ]
    },
    {
      "type": "object",
      "properties": {
        "lease": {
          "type": "string",
          "minLength": 1,
          "pattern": "^J-[1-9][0-9]*(\\.[1-9][0-9]*)*$"
        },
        "holder": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "^[^/\\s]+@[0-7][0-9A-HJKMNP-TV-Z]{25}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "fence": {
          "type": "integer",
          "minimum": 1
        },
        "gen": {
          "type": "integer",
          "minimum": 0
        },
        "attempt": {
          "type": "integer",
          "minimum": 1
        },
        "since": {
          "type": "string",
          "minLength": 1,
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
        },
        "pid": {
          "type": "null"
        },
        "pid_start": {
          "type": "null"
        }
      },
      "required": [
        "lease",
        "holder",
        "fence",
        "gen",
        "attempt",
        "since",
        "pid",
        "pid_start"
      ],
      "additionalProperties": false
    },
    {
      "$ref": "merge-lease.json"
    }
  ]
}
