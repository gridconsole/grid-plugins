{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/grid/contract/job.json",
  "title": "job",
  "allOf": [
    {
      "$ref": "envelope.json"
    },
    {
      "properties": {
        "type": {
          "const": "job"
        },
        "type_v": {
          "const": 1
        },
        "author": {
          "properties": {
            "role": {
              "enum": [
                "lead",
                "owner",
                "member",
                "cli",
                "agent"
              ]
            }
          }
        },
        "body": {
          "oneOf": [
            {
              "$ref": "job-record.json"
            },
            {
              "type": "object",
              "properties": {
                "ref": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^bodies/[0-7][0-9A-HJKMNP-TV-Z]{25}\\.json$"
                }
              },
              "required": [
                "ref"
              ],
              "additionalProperties": false
            }
          ]
        },
        "job": {
          "type": "string",
          "minLength": 1,
          "pattern": "^J-[1-9][0-9]*(\\.[1-9][0-9]*)*$"
        }
      }
    },
    {
      "if": {
        "properties": {
          "author": {
            "properties": {
              "role": {
                "enum": [
                  "agent"
                ]
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "body": {
            "properties": {
              "kind": {
                "const": "approve"
              },
              "role": {
                "const": "Person"
              }
            },
            "required": [
              "kind",
              "role"
            ]
          }
        }
      }
    }
  ],
  "x-class": "state",
  "x-roles": [
    "lead",
    "owner",
    "member",
    "cli"
  ]
}
